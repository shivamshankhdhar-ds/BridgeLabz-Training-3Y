            text-decoration: none;
            color: var(--text-gray);
            font-weight: 500;
            font-size: 0.95rem;
            transition: color 0.3s ease;
        }

        .nav-item a:hover {
            color: var(--text-light);
        }

        .header-btn {
            background-color: transparent;
            color: var(--text-light);
            border: 1px solid var(--accent-blue);
            padding: 0.5rem 1.2rem;
            border-radius: 8px;
            font-weight: 600;
            font-size: 0.9rem;
            cursor: pointer;
            transition: all 0.3s ease;
            outline: 2px solid transparent;
        }

        .header-btn:focus-visible {
            outline: 2px solid var(--accent-blue);
            outline-offset: 3px;
        }

        .header-btn:hover {
            background-color: var(--accent-blue);
            color: #000;
            box-shadow: 0 0 15px rgba(6, 182, 212, 0.4);
        }

        .hero-section {
            position: relative;
            min-height: 85vh;
            background-image: url('images/space-hero.svg');
            background-repeat: no-repeat;
            background-position: center;
            background-size: cover;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 4rem 1.5rem;
        }

        .hero-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: radial-gradient(circle at center, rgba(7, 9, 19, 0) 0%, var(--bg-dark) 95%);
            pointer-events: none;
        }

        .hero-welcome-box {
            position: relative;
            z-index: 10;
            max-width: 850px;
        }

        .hero-welcome-box h1 {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 4rem;
            font-weight: 700;
            line-height: 1.15;
            margin-bottom: 1.5rem;
            background: linear-gradient(to right, #ffffff, var(--text-gray));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .hero-welcome-box p {
            color: var(--text-gray);
            font-size: 1.25rem;
            max-width: 600px;
            margin: 0 auto 2.5rem auto;
            line-height: 1.6;
        }

        .hero-cta {
            display: inline-block;
            text-decoration: none;
            background: linear-gradient(to right, var(--accent-purple), var(--accent-pink));
            color: #ffffff;
            font-weight: 700;
            padding: 1rem 2.2rem;
            border-radius: 30px;
            box-shadow: 0 10px 20px rgba(139, 92, 246, 0.3);
            transition: all 0.3s ease;
            border: 2px solid transparent;
        }

        .hero-cta:hover {
            transform: translateY(-2px);
            box-shadow: 0 15px 30px rgba(236, 72, 153, 0.45);
        }

        .absolute-badge {
            position: absolute;
            bottom: 40px;
            left: 5%;
            background-color: rgba(255, 255, 255, 0.05);
            border: var(--border-glow);
            padding: 0.8rem 1.5rem;
            border-radius: 50px;
            backdrop-filter: blur(8px);
            font-size: 0.85rem;
            display: flex;
            align-items: center;
            gap: 0.6rem;
            z-index: 10;
        }

        .pulse-dot {
            width: 8px;
            height: 8px;
            background-color: var(--accent-blue);
            border-radius: 50%;
            box-shadow: 0 0 8px var(--accent-blue);
        }

        .about-section {
            padding: 8rem 5%;
            max-width: 1200px;
            margin: 0 auto;
            display: flex;
            align-items: center;
            gap: 4rem;
        }

        .about-text-col {
            flex: 1;
        }

        .section-label {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 0.9rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 2px;
            color: var(--accent-purple);
            margin-bottom: 0.8rem;
        }

        .about-text-col h2 {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 2.5rem;
            font-weight: 700;
            line-height: 1.25;
            margin-bottom: 1.5rem;
        }

        .about-text-col p {
            color: var(--text-gray);
            font-size: 1.05rem;
            margin-bottom: 1.8rem;
        }

        .about-image-col {
            flex: 1;
            display: flex;
            justify-content: center;
        }

        .about-image {
            width: 100%;
            max-width: 450px;
            border-radius: 16px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.4);
            border: var(--border-glow);
        }

        .services-section {
            padding: 6rem 5% 8rem 5%;
            background-color: rgba(15, 23, 42, 0.3);
            border-top: 1px solid rgba(255, 255, 255, 0.03);
            border-bottom: 1px solid rgba(255, 255, 255, 0.03);
        }

        .services-container {
            max-width: 1200px;
            margin: 0 auto;
        }

        .services-header {
            text-align: center;
            margin-bottom: 4rem;
        }

        .services-header h2 {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
        }

        .services-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 2.5rem;
        }

        .service-box {
            background-color: var(--bg-card);
            border: var(--border-glow);
            border-radius: 16px;
            padding: 2.5rem;
            margin: 0;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            outline: 1px solid transparent;
        }

        .service-box:hover {
            transform: translateY(-8px);
            border-color: var(--accent-purple);
            box-shadow: 0 15px 35px rgba(139, 92, 246, 0.15);
            outline: 2px solid rgba(139, 92, 246, 0.4);
        }

        .service-icon {
            font-size: 2.5rem;
            margin-bottom: 1.5rem;
        }

        .service-box h3 {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 1.35rem;
            font-weight: 700;
            margin-bottom: 0.8rem;
            color: var(--text-light);
        }

        .service-box p {
            color: var(--text-gray);
            font-size: 0.95rem;
            line-height: 1.6;
        }

        .contact-section {
            padding: 8rem 5%;
            max-width: 600px;
            margin: 0 auto;
            text-align: center;
        }

        .contact-section h2 {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 0.8rem;
        }

        .contact-section p {
            color: var(--text-gray);
            font-size: 1.05rem;
            margin-bottom: 3rem;
        }

        .contact-form {
            background-color: var(--bg-card);
            border: var(--border-glow);
            border-radius: 16px;
            padding: 2.5rem;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.3);
            text-align: left;
        }

        .form-group {
            margin-bottom: 1.5rem;
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .form-label {
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--text-gray);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .form-input, .form-textarea {
            width: 100%;
            padding: 0.85rem 1rem;
            font-size: 0.95rem;
            font-family: inherit;
            background-color: rgba(7, 9, 19, 0.8);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 8px;
            color: #ffffff;
            transition: all 0.3s ease;
            outline: 2px solid transparent;
        }

        .form-textarea {
            min-height: 100px;
            resize: vertical;
        }

        .form-input:focus, .form-textarea:focus {
            outline: 2px solid var(--accent-purple);
            outline-offset: 1px;
            background-color: #070913;
            border-color: transparent;
        }

        .form-submit {
            width: 100%;
            background: linear-gradient(to right, var(--accent-purple), var(--accent-pink));
            color: #ffffff;
            font-size: 1rem;
            font-weight: 700;
            padding: 1rem;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            box-shadow: 0 5px 15px rgba(139, 92, 246, 0.2);
            transition: all 0.3s ease;
        }

        .form-submit:hover {
            opacity: 0.95;
            box-shadow: 0 8px 20px rgba(236, 72, 153, 0.35);
        }

        .footer-section {
            background-color: #03040a;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
            padding: 3rem 2rem;
            text-align: center;
            color: #475569;
            font-size: 0.85rem;
        }

        .fixed-action-badge {
            position: fixed;
            bottom: 25px;
            right: 25px;
            background: rgba(22, 28, 45, 0.8);
            border: 1px solid var(--accent-blue);
            color: var(--accent-blue);
            padding: 0.6rem 1.2rem;
            border-radius: 50px;
            font-size: 0.8rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            box-shadow: 0 5px 15px rgba(6, 182, 212, 0.25);
            backdrop-filter: blur(8px);
            z-index: 1000;
            text-decoration: none;
            transition: all 0.3s ease;
        }

        .fixed-action-badge:hover {
            background-color: var(--accent-blue);
            color: #000;
            box-shadow: 0 8px 25px rgba(6, 182, 212, 0.45);
            transform: translateY(-2px);
        }

        @media (max-width: 968px) {
            .about-section {
                flex-direction: column;
                text-align: center;
                gap: 3rem;
                padding: 5rem 5%;
            }

            .services-grid {
                grid-template-columns: 1fr;
                gap: 2rem;
            }

            .hero-welcome-box h1 {
                font-size: 2.8rem;
            }
        }

        @media (max-width: 600px) {
            .sticky-header {
                flex-direction: column;
                height: auto;
                padding: 1.5rem 1rem;
                gap: 1rem;
            }

            .nav-menu {
                gap: 1.2rem;
            }

            .hero-welcome-box h1 {
                font-size: 2.2rem;
            }

            .about-text-col h2, .services-header h2, .contact-section h2 {
                font-size: 2rem;
            }
            
            .contact-form {
                padding: 1.5rem;
            }
        }
    </style>
</head>
<body>

    <header class="sticky-header">
        <div class="brand-logo">NEBULA VOYAGES</div>
        <ul class="nav-menu">
            <li class="nav-item"><a href="#hero">Home</a></li>
            <li class="nav-item"><a href="#about">About</a></li>
            <li class="nav-item"><a href="#services">Services</a></li>
            <li class="nav-item"><a href="#contact">Contact</a></li>
        </ul>
        <button class="header-btn" type="button">Book Orbit</button>
    </header>

    <section class="hero-section" id="hero">
        <div class="hero-overlay"></div>
        <div class="hero-welcome-box">
            <h1>Voyage Beyond the Horizon</h1>
            <p>
                Experience the next frontier of luxury travel. Embark on custom journeys through low-Earth orbit, lunar resorts, and deep space panoramas.
            </p>
            <a href="#contact" class="hero-cta">Reserve Your Suite</a>
        </div>

        <div class="absolute-badge">
            <div class="pulse-dot"></div>
            <span>Next launch: Oct 2026</span>
        </div>
    </section>

    <section class="about-section" id="about">
        <div class="about-text-col">
            <div class="section-label">Our Mission</div>
            <h2>Revolutionizing Space Tourism</h2>
            <p>
                At Nebula Voyages, we believe space shouldn't be the exclusive domain of astronauts. Since 2024, our team has built safety-certified, reusable spacecraft designed specifically to offer civilians unprecedented comfort and breathtaking planetary views.
            </p>
            <p>
                From gourmet orbital dining to space walk excursions guided by veteran pilots, we redefine tourism by bridging safety, luxury, and spiritual discovery.
            </p>
        </div>
        <div class="about-image-col">
            <img class="about-image" src="images/space-about.svg" alt="Illustration of a futuristic space station core ring and solar panels.">
        </div>
    </section>

    <section class="services-section" id="services">
        <div class="services-container">
            <header class="services-header">
                <div class="section-label">Offerings</div>
                <h2>Curated Expeditions</h2>
            </header>

            <div class="services-grid">
                <article class="service-box">
                    <div class="service-icon">🛰️</div>
                    <h3>Orbital Cruises</h3>
                    <p>
                        Spend 3 to 7 days in low-Earth orbit inside our luxurious zero-gravity suites, taking in 16 sunrise vistas every 24 hours.
                    </p>
                </article>

                <article class="service-box">
                    <div class="service-icon">🌙</div>
                    <h3>Lunar Resorts</h3>
                    <p>
                        Touch down in the tranquil Sea of Serenity. Stay at the dome habitats, offering low-gravity golf and crater exploration.
                    </p>
                </article>

                <article class="service-box">
                    <div class="service-icon">🛸</div>
                    <h3>Deep Space Tours</h3>
                    <p>
                        Venture past the moon on high-speed flybys. Witness the spectacular lunar far side and planetary alignment sweeps.
                    </p>
                </article>
            </div>
        </div>
    </section>

    <section class="contact-section" id="contact">
        <h2>Inquire Space Reservation</h2>
        <p>Your journey stars with a consultation. Fill out the form below and our orbital planners will contact you.</p>
        
        <form class="contact-form" action="#" method="POST">
            <div class="form-group">
                <label for="c-name" class="form-label">Name</label>
                <input class="form-input" type="text" id="c-name" name="name" required placeholder="John Doe">
            </div>
            
            <div class="form-group">
                <label for="c-email" class="form-label">Email</label>
                <input class="form-input" type="email" id="c-email" name="email" required placeholder="john@example.com">
            </div>
            
            <div class="form-group">
                <label for="c-message" class="form-label">Preferred Voyage details</label>
                <textarea class="form-textarea" id="c-message" name="message" required placeholder="e.g. Lunar resort suite package, October 2026..."></textarea>
            </div>
            
            <button class="form-submit" type="submit">Submit Request</button>
        </form>
    </section>

    <footer class="footer-section">
        <p>&copy; 2026 Nebula Voyages Inc. All rights reserved. Built using standard CSS layout, positioning models, and variables.</p>
    </footer>

    <a class="fixed-action-badge" href="#hero">Launch Status: OK</a>

</body>
</html>
